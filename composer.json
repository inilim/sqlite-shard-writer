{
    "name": "inilim/sqlite-shard-writer",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Inilim\\SqliteShard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inilim\\Test\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "inilim"
        },
        {
            "name": "Web community"
        }
    ],
    "scripts": {
        "tests": [
            "php vendor/bin/phpunit tests"
        ],
        "stan": [
            "php vendor/bin/phpstan analyze"
        ]
    },
    "require": {
        "php": ">=8.4",
        "inilim/di": "0.0.*",
        "inilim/ipdo": "0.0.*",
        "inilim/tools": "0.0.*",
        "symfony/finder": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.2",
        "inilim/parallel": "0.0.*"
    }
}